{
	"name": "ros",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"DEVCONTAINER_ROS_IMAGE_TAG": "jazzy",
			"USERNAME": "ubuntu"
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/infield_robotics_ws,type=bind",
	"workspaceFolder": "/home/ubuntu/infield_robotics_ws",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-iot.vscode-ros",
				"ms-python.python"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash", 
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "/bin/bash"
					}
				},
				"python.terminal.activateEnvironment": false
			}
		}
	},
	
	"postCreateCommand": "chmod +x .devcontainer/postcreatecommand.sh && .devcontainer/postcreatecommand.sh",
	"forwardPorts": [8765]

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
